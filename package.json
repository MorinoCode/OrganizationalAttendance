{
  "name": "hozor-ghiab",
  "version": "1.1.8",
  "description": "Local attendance and payroll desktop system for Windows (Kuwait edition)",
  "repository": {
    "type": "git",
    "url": "https://github.com/MorinoCode/OrganizationalAttendance.git"
  },
  "main": "src/main/main.cjs",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "electron": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "postinstall": "electron-builder install-app-deps",
    "smoke": "node scripts/smoke.mjs",
    "smoke:packaged": "npm run dist:dir && node scripts/smoke.mjs --packaged"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.11",
    "exceljs": "^4.4.0",
    "i18next": "^27.2.9",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.4.1",
    "tailwind-merge": "^3.0.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.7",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.2.7",
    "wait-on": "^9.5.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "build": {
    "appId": "kw.hozorghiab.desktop",
    "productName": "نظام الحضور والرواتب",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "نظام-الحضور-والرواتب-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "نظام الحضور والرواتب",
      "differentialPackage": false
    },
    "publish": {
      "provider": "github",
      "owner": "MorinoCode",
      "repo": "OrganizationalAttendance",
      "releaseType": "release"
    }
  }
}
